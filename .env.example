# Copy to .env and fill in. Never commit .env.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe to ship in the app; RLS protects data.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...). Server-side only: used by backend/seed.ts. Never prefix with EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
